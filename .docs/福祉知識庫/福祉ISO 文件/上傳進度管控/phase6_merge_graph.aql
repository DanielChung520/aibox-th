// ═══════════════════════════════════════════════════════════════
// Phase 6: 跨檔案圖譜整合 — AQL Merge 腳本
// ═══════════════════════════════════════════════════════════════
// 
// 使用方式：依序執行 STEP_A ~ STEP_D
// 每個 STEP 是獨立的 AQL 查詢，分開執行不可合併
// 可透過批次腳本自動執行: python batch_upload_welfare_iso.py --merge
//
// ═══════════════════════════════════════════════════════════════

// ============================================================
// [STEP_A] 清理舊資料
// 執行前先確認 merged_graphs 與 merged_edges 集合已建立
// ============================================================
// FOR m IN merged_graphs FILTER m.root_id == "kb_welfare_iso" REMOVE m IN merged_graphs OPTIONS { ignoreErrors: true }
// FOR e IN merged_edges FILTER e.root_id == "kb_welfare_iso" REMOVE e IN merged_edges OPTIONS { ignoreErrors: true }

// ============================================================
// [STEP_B] 跨檔案同名實體合併
// 將 knowledge_graphs 中的實體統整到 merged_graphs
// ============================================================
LET root = "kb_welfare_iso"

FOR g IN knowledge_graphs
  FILTER g.root_id == root
  COLLECT entity_name = g.entity INTO groups = {
    file_id: g.file_id,
    type: g.entity_type,
    descr: g.description
  }
  // 計算最常見的 entity_type
  LET type_counts = (
    FOR gr IN groups
      COLLECT t = gr.type WITH COUNT INTO cnt
      SORT cnt DESC LIMIT 1
      RETURN t
  )
  LET best_type = FIRST(type_counts) || FIRST(groups).type || "concept"
  INSERT {
    entity: entity_name,
    entity_type: best_type,
    root_id: root,
    source_files: UNIQUE(groups[*].file_id),
    merge_count: LENGTH(groups),
    description: SUBSTRING(CONCAT_SEPARATOR("; ", UNIQUE(groups[*].descr)), 0, 2000),
    is_merged: LENGTH(groups) > 1
  } INTO merged_graphs OPTIONS { ignoreErrors: true }
  RETURN {
    entity: entity_name,
    type: best_type,
    files: LENGTH(UNIQUE(groups[*].file_id)),
    merged: LENGTH(groups) > 1
  }

// ============================================================
// [STEP_C] 建立文檔階層關係邊
// ============================================================
LET root = "kb_welfare_iso"

// C1: QM─governs→QP
FOR qm IN merged_graphs
  FILTER qm.root_id == root AND STARTS_WITH(qm.entity, "QM-")
  FOR qp IN merged_graphs
    FILTER qp.root_id == root AND STARTS_WITH(qp.entity, "QP-")
    INSERT {
      _from: CONCAT("merged_graphs/", qm._key),
      _to: CONCAT("merged_graphs/", qp._key),
      relation: "governs",
      root_id: root,
      description: CONCAT(qm.entity, " 管轄 ", qp.entity)
    } INTO merged_edges OPTIONS { ignoreErrors: true }
    RETURN { type: "qm_qp", from: qm.entity, to: qp.entity }

// C2: QP─defines_form→TB
FOR qp IN merged_graphs
  FILTER qp.root_id == root AND STARTS_WITH(qp.entity, "QP-")
  FOR tb IN merged_graphs
    FILTER tb.root_id == root AND STARTS_WITH(tb.entity, "TB-")
    INSERT {
      _from: CONCAT("merged_graphs/", qp._key),
      _to: CONCAT("merged_graphs/", tb._key),
      relation: "defines_form",
      root_id: root,
      description: CONCAT(qp.entity, " 定義表單 ", tb.entity)
    } INTO merged_edges OPTIONS { ignoreErrors: true }

// C3: QP-T03/T05~T08─governs→WP/WO/WC/WI
FOR qp IN merged_graphs
  FILTER qp.root_id == root AND qp.entity IN ["QP-T03", "QP-T05", "QP-T06", "QP-T07", "QP-T08"]
  FOR w IN merged_graphs
    FILTER w.root_id == root AND (
      STARTS_WITH(w.entity, "WP-") OR
      STARTS_WITH(w.entity, "WO-") OR
      STARTS_WITH(w.entity, "WC-") OR
      STARTS_WITH(w.entity, "WI-")
    )
    INSERT {
      _from: CONCAT("merged_graphs/", qp._key),
      _to: CONCAT("merged_graphs/", w._key),
      relation: "governs",
      root_id: root,
      description: CONCAT(qp.entity, " 管轄 ", w.entity)
    } INTO merged_edges OPTIONS { ignoreErrors: true }

// ============================================================
// [STEP_D] 建立模板─實例 + 廠區關係邊
// ============================================================
LET root = "kb_welfare_iso"

// D1: TB-T17─filled_by→儀器 (SM/TM/M0xx)
FOR t17 IN merged_graphs
  FILTER t17.root_id == root AND t17.entity == "TB-T17"
  FOR inst IN merged_graphs
    FILTER inst.root_id == root AND (
      STARTS_WITH(inst.entity, "SM") OR
      STARTS_WITH(inst.entity, "TM") OR
      inst.entity_type == "Instrument"
    )
    INSERT {
      _from: CONCAT("merged_graphs/", t17._key),
      _to: CONCAT("merged_graphs/", inst._key),
      relation: "filled_by",
      root_id: root,
      description: CONCAT(t17.entity, " 被 ", inst.entity, " 填寫")
    } INTO merged_edges OPTIONS { ignoreErrors: true }

// D2: TB-T13─filled_by→設備 (E001~E029)
FOR t13 IN merged_graphs
  FILTER t13.root_id == root AND t13.entity == "TB-T13"
  FOR eq IN merged_graphs
    FILTER eq.root_id == root AND STARTS_WITH(eq.entity, "E") AND LENGTH(eq.entity) == 4
    INSERT {
      _from: CONCAT("merged_graphs/", t13._key),
      _to: CONCAT("merged_graphs/", eq._key),
      relation: "filled_by",
      root_id: root,
      description: CONCAT(t13.entity, " 被 ", eq.entity, " 填寫")
    } INTO merged_edges OPTIONS { ignoreErrors: true }

// D3: 樹八廠(SM)─has_instrument→SMxx/M0xx
FOR f IN merged_graphs
  FILTER f.root_id == root AND f.entity == "SM" AND f.entity_type == "Factory_Unit"
  FOR inst IN merged_graphs
    FILTER inst.root_id == root AND (
      (STARTS_WITH(inst.entity, "SM") AND LENGTH(inst.entity) >= 3) OR
      (STARTS_WITH(inst.entity, "M0") AND LENGTH(inst.entity) >= 3)
    )
    INSERT {
      _from: CONCAT("merged_graphs/", f._key),
      _to: CONCAT("merged_graphs/", inst._key),
      relation: "has_instrument",
      root_id: root,
      description: CONCAT(f.entity, " 擁有儀器 ", inst.entity)
    } INTO merged_edges OPTIONS { ignoreErrors: true }

// D4: 土城廠(TM)─has_instrument→TMxx
FOR f IN merged_graphs
  FILTER f.root_id == root AND f.entity == "TM" AND f.entity_type == "Factory_Unit"
  FOR inst IN merged_graphs
    FILTER inst.root_id == root AND STARTS_WITH(inst.entity, "TM") AND LENGTH(inst.entity) >= 3
    INSERT {
      _from: CONCAT("merged_graphs/", f._key),
      _to: CONCAT("merged_graphs/", inst._key),
      relation: "has_instrument",
      root_id: root,
      description: CONCAT(f.entity, " 擁有儀器 ", inst.entity)
    } INTO merged_edges OPTIONS { ignoreErrors: true }
