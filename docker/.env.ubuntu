# =============================================
# ABC Desktop — Ubuntu/DGX 環境設定範本
# =============================================
#
# 使用方式:
#   1. cp docker/.env.ubuntu docker/.env
#   2. 編輯 docker/.env 修改密碼等機敏資訊
#   3. docker compose --env-file docker/.env up -d
#
# 注意:
#   - ArangoDB 密碼請先修改再上線
#   - JWT_SECRET 請換成隨機字串
#   - VITE_API_URL 設為對外公開的 API 位址
# =============================================

# --- Database ---
ARANGODB_URL=http://arangodb:8529
ARANGODB_DATABASE=abc_desktop
ARANGODB_USERNAME=root
ARANGODB_PASSWORD=abc_desktop_2026

# --- Queue ---
REDIS_URL=redis://redis:6379/0

# --- Vector Database ---
QDRANT_URL=http://qdrant:6333

# --- File Storage (SeaweedFS) ---
SEAWEED_URL=http://seaweedfs-filer:8888

# --- LLM ---
OLLAMA_BASE_URL=http://ollama:11434
# Embedding model for RAG
EMBEDDING_MODEL=bge-m3:latest

# --- Python AI Services ---
AITASK_URL=http://aitask:8001
UNIFIED_AGENTS_URL=http://unified_agents:8011
MCP_TOOLS_URL=http://mcp_tools:8004
AIQ_AGENT_URL=http://aiq_agent:8009
SKILLS_RAG_URL=http://skills_rag:8012

# --- Rust API Gateway ---
PORT=6500
JWT_SECRET=abc-desktop-jwt-secret-2026

# --- Frontend API URL (for browser access) ---
# 這是 LINE Mini App 從瀏覽器存取時要呼叫的 API 位址
# 如果透過 tunnel: https://eeaapi.ent4i.com
# 如果是 public IP: http://YOUR_UBUNTU_IP:6500
VITE_API_URL=https://eeaapi.ent4i.com

# --- Ollama GPU Settings ---
# 在 DGX-Spark 上，Ollama 會自動使用 GPU
# 若要指定 GPU: NVIDIA_VISIBLE_DEVICES=0
# OLLAMA_NUM_PARALLEL=4
# OLLAMA_MAX_LOADED_MODELS=2

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
