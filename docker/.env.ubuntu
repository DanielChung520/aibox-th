# =============================================
# ABC Desktop — Ubuntu/DGX 部署環境設定
# =============================================
#
# 使用方式:
#   1. 先啟動基礎設施：docker compose --env-file docker/.env.ubuntu -f docker-compose.infra.yml up -d
#   2. 再啟動應用服務：docker compose --env-file docker/.env.ubuntu -f docker/docker-compose.yml up -d
#
# 注意:
#   - ArangoDB 密碼請先修改再上線
#   - JWT_SECRET 請換成隨機字串
#   - 若 DGX 上 Ollama 已安裝在 host 模式，可跳過 infra 中的 ollama 服務，
#     並將 OLLAMA_BASE_URL 設為 http://host.docker.internal:11434
# =============================================

# ── Database ──────────────────────────────────
ARANGODB_URL=http://arangodb:8529
ARANGODB_DATABASE=abc_desktop
ARANGODB_USERNAME=root
ARANGODB_PASSWORD=abc_desktop_2026

# ── Queue ─────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Vector Database ───────────────────────────
QDRANT_URL=http://qdrant:6333

# ── File Storage (SeaweedFS) ──────────────────
SEAWEED_URL=http://seaweedfs-filer:8888

# ── LLM ───────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
# Embedding model for RAG
EMBEDDING_MODEL=bge-m3:latest

# ── Python AI Services ────────────────────────
AITASK_URL=http://aitask:8001
UNIFIED_AGENTS_URL=http://unified_agents:8011
MCP_TOOLS_URL=http://mcp_tools:8004
AIQ_AGENT_URL=http://aiq_agent:8009
SKILLS_RAG_URL=http://skills_rag:8012

# ── Rust API Gateway ──────────────────────────
API_PORT=6500
JWT_SECRET=abc-desktop-jwt-secret-2026

# ── Frontend API URL (for browser access) ─────
# 這是 LINE Mini App 從瀏覽器存取時要呼叫的 API 位址
# 如果透過 tunnel: https://eeaapi.ent4i.com
# 如果是 public IP: http://YOUR_UBUNTU_IP:6500
VITE_API_URL=https://eeaapi.ent4i.com

# ── Ollama GPU Settings ───────────────────────
# 在 DGX-Spark 上，Ollama container 會自動使用 GPU
# 若使用 host 本機 Ollama：
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── Celery ────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
