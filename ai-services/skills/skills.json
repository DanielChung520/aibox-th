      "version": "1.0.0",
      "source": "skills/customer_intent_recorder/skill.py",
      "intent_hints": {
        "triggers": [
          "intent_record",
          "customer_analysis"
        ],
        "keywords": [
          "記錄",
          "分析",
          "轉達",
          "意圖"
        ],
        "example_phrases": [
          "我想問一下產品保固多久",
          "可以幫我查詢訂單進度嗎",
          "我對你們的服務有意見"
        ]
      },
      "input": {
        "message": "string: 客戶原始訊息",
        "business_user_key": "string: 綁定業務 ID",
        "channel_key": "string: 管道識別碼",
        "customer_name": "string: 客戶名稱",
        "session_id": "string: 對話 ID"
