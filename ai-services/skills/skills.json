  "skills": [
    {
      "name": "ragic_timeline_poller",
      "description": "輪巡 Ragic 表單，比對客戶名稱，將活動摘要寫入 customer_timelines",
      "version": "1.0.0",
      "source": "skills/ragic_timeline_poller/skill.py",
      "intent_hints": {
        "triggers": [
          "ragic_poll",
          "timeline_sync",
          "erp_sync"
        ],
        "keywords": [
          "輪巡",
          "同步",
          "Ragic",
          "ERP",
          "活動記錄",
          "報價",
          "訂單",
          "銷貨",
          "退貨",
          "折讓",
          "timeline"
        ],
        "example_phrases": [
          "同步客戶的 ERP 活動記錄",
          "輪巡報價單和訂單",
          "更新客戶 timeline",
          "查詢最近的出貨記錄"
        ]
      },
      "input": {
        "table_configs": "array: 輪巡表單設定 [{tab_path, sheet_index, event_type, date_field, customer_field, summary_template}]",
        "interval_minutes": "number: 輪巡間隔（預設 15）",
        "mode": "enum: poll_all | poll_table | manual_sync"
      },
      "output": {
        "synced_count": "number: 本次寫入筆數",
        "errors": "array: 錯誤記錄"
      },
      "dependencies": [
        "data_agent.ragic.client",
        "shared.multimedia"
      ],
      "label": "Ragic 活動同步"
    },
    {
